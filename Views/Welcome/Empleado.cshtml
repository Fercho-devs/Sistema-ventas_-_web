@{
    Layout = null;
    var nombre = ViewBag.Nombre as string;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Panel Empleado — Quesito Store</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Playfair+Display:ital,wght@0,600;1,600&display=swap" rel="stylesheet">
    <style>
            body {
                font-family: 'Inter', sans-serif;
                background: #0a0a0a;
                color: #fff;
                min-height: 100vh;
            }

            .navbar {
                background: transparent;
                padding: 20px 0;
                border-bottom: 1px solid #1a1a1a;
                margin-bottom: 50px;
            }

            .navbar-brand {
                font-family: 'Playfair Display', serif;
                font-weight: 600;
                font-size: 2rem;
                color: #fff !important;
                letter-spacing: 1px;
                text-decoration: none;
            }

                .navbar-brand span {
                    color: #e63946;
                }

            .btn-pill-white {
                background: #fff;
                color: #000;
                border-radius: 50px;
                padding: 8px 20px;
                font-weight: 600;
                font-size: 0.9rem;
                border: none;
                transition: all 0.3s;
                text-decoration: none;
            }

                .btn-pill-white:hover {
                    background: #e0e0e0;
                    color: #000;
                }

            .panel-header {
                margin-bottom: 60px;
            }

                .panel-header .subtitle {
                    color: #e63946;
                    font-size: 0.85rem;
                    font-weight: 600;
                    letter-spacing: 4px;
                    text-transform: uppercase;
                    margin-bottom: 10px;
                }

                .panel-header h2 {
                    font-size: 2.5rem;
                    font-weight: 700;
                    margin-bottom: 15px;
                }

                .panel-header .welcome-text {
                    color: #888;
                    font-size: 1.1rem;
                    max-width: 600px;
                }

            .menu-card {
                background: #111;
                border: 1px solid #222;
                border-radius: 20px;
                padding: 3rem 2.5rem;
                text-decoration: none;
                color: #fff;
                display: block;
                transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
                height: 100%;
                position: relative;
                overflow: hidden;
            }

                .menu-card::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    right: 0;
                    height: 4px;
                    background: linear-gradient(90deg, #e63946, #ff6b6b);
                    transform: scaleX(0);
                    transform-origin: left;
                    transition: transform 0.4s ease;
                }

                .menu-card:hover {
                    border-color: #e63946;
                    transform: translateY(-8px);
                    box-shadow: 0 20px 40px rgba(230, 57, 70, 0.15);
                    color: #fff;
                }

                    .menu-card:hover::before {
                        transform: scaleX(1);
                    }

            .menu-icon {
                width: 80px;
                height: 80px;
                border-radius: 20px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 2.5rem;
                margin-bottom: 2rem;
                background: #1a1a1a;
                border: 1px solid #333;
                transition: all 0.4s ease;
            }

            .menu-card:hover .menu-icon {
                background: #e63946;
                color: #fff;
                border-color: #e63946;
                transform: scale(1.05);
            }

            .menu-card h4 {
                font-size: 1.8rem;
                font-weight: 700;
                margin-bottom: 1rem;
                transition: color 0.3s ease;
            }

            .menu-card:hover h4 {
                color: #e63946;
            }

            .menu-card p {
                color: #888;
                font-size: 1rem;
                line-height: 1.6;
                margin-bottom: 2rem;
            }

            .menu-card .arrow-icon {
                position: absolute;
                bottom: 2rem;
                right: 2rem;
                font-size: 1.5rem;
                color: #444;
                transition: all 0.3s ease;
            }

            .menu-card:hover .arrow-icon {
                color: #e63946;
                transform: translateX(5px);
            }

            @@media (max-width: 768px) {
                .panel-header h2 {
                    font-size: 1.8rem;
                }

                .menu-card {
                    padding: 2rem 1.5rem;
                }

                .menu-icon {
                    width: 60px;
                    height: 60px;
                    font-size: 2rem;
                }

                .menu-card h4 {
                    font-size: 1.4rem;
                }
            }
    </style>
</head>
<body>
    <nav class="navbar">
        <div class="container d-flex justify-content-between align-items-center">
            <a class="navbar-brand" href="#">QUESITO<span>.</span> <small class="fw-normal text-muted ms-2" style="font-size:0.9rem; font-family:'Inter',sans-serif; letter-spacing:0;">Empleado</small></a>
            <div class="d-flex align-items-center gap-3">
                <span class="text-muted small d-none d-md-block"><i class="bi bi-person-circle me-1" style="color:#e63946;"></i>@nombre</span>
                <form asp-controller="Login" asp-action="Salir" method="post" class="d-inline m-0 p-0">
                    <button type="submit" class="btn btn-pill-white">Salir <i class="bi bi-box-arrow-right"></i></button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="panel-header">
            <p class="subtitle">Panel de Control</p>
            <h2>Bienvenido/a, @nombre</h2>
            <p class="welcome-text">Gestiona los pedidos de la tienda. Selecciona una opción para comenzar.</p>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <a asp-controller="Pedido" asp-action="EmpleadoPedidos" class="menu-card">
                    <div class="menu-icon" style="color:#e63946;">
                        <i class="bi bi-bag-check"></i>
                    </div>
                    <h4>Pedidos Activos</h4>
                    <p>Gestionar pedidos de clientes: marcar como pagado, enviado, recogido o cancelar.</p>
                    <i class="bi bi-arrow-right arrow-icon"></i>
                </a>
            </div>

            <div class="col-md-6">
                <a asp-controller="Pedido" asp-action="EmpleadoHistorial" class="menu-card">
                    <div class="menu-icon" style="color:#e63946;">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <h4>Historial</h4>
                    <p>Ver registro completo de pedidos finalizados o cancelados con detalles de cada acción.</p>
                    <i class="bi bi-arrow-right arrow-icon"></i>
                </a>
            </div>
        </div>
    </div>
</body>
</html>