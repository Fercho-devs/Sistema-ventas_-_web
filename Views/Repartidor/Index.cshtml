@model IEnumerable<SistemaWeb_Ventas.Models.Entrega>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mis entregas — Repartidor</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/responsive.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body { background: #0a0a0a; color: #fff; font-family: 'Segoe UI', sans-serif; }
        .navbar { border-bottom: 1px solid #222; padding: 20px 0; }
        .brand { color: #fff; text-decoration: none; font-size: 1.8rem; font-weight: 700; }
        .brand span { color: #e63946; }
        .delivery-card { background: #111; border: 1px solid #222; border-radius: 14px; padding: 20px; }
        .label { color: #888; font-size: 0.85rem; }
        .btn-red { background: #e63946; color: #fff; border: none; }
        .btn-red:hover { background: #c1121f; color: #fff; }
        .btn-pill { border-radius: 50px; }
    </style>
</head>
<body>
    <nav class="navbar">
        <div class="container d-flex justify-content-between align-items-center">
            <a class="brand" href="#">QUESITO<span>.</span></a>
            <form asp-controller="Login" asp-action="Salir" method="post">
                <button type="submit" class="btn btn-outline-light btn-pill">Salir</button>
            </form>
        </div>
    </nav>

    <div class="container py-4">
        <h3 class="fw-bold mb-2">Mis entregas</h3>
        <p class="text-muted mb-4">@ViewBag.Nombre</p>

        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success">@TempData["MensajeExito"]</div>
        }
        @if (TempData["ErrorEntrega"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorEntrega"]</div>
        }

        @if (!Model.Any())
        {
            <div class="delivery-card text-center py-5">
                <i class="bi bi-truck fs-1 text-secondary"></i>
                <h5 class="mt-3">No tienes entregas asignadas</h5>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var entrega in Model)
                {
                    <div class="col-lg-6">
                        <div class="delivery-card h-100">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="mb-1">Pedido #@entrega.Pedido?.IdPedido</h5>
                                    <span class="badge bg-secondary">@entrega.Pedido?.EstadoPedido</span>
                                </div>
                                <span class="text-danger fw-bold">S/ @entrega.Pedido?.Total.ToString("0.00")</span>
                            </div>

                            <p class="mb-2"><span class="label">Cliente:</span> <strong>@entrega.Pedido?.Cliente?.NombreUsuario</strong></p>
                            <p class="mb-2"><span class="label">Entrega:</span> @entrega.Pedido?.TipoEntrega?.Nombre</p>
                            @if (!string.IsNullOrEmpty(entrega.CiudadDestino))
                            {
                                <p class="mb-2"><span class="label">Ciudad:</span> @entrega.CiudadDestino</p>
                            }
                            @if (!string.IsNullOrEmpty(entrega.DireccionDestino))
                            {
                                <p class="mb-3"><span class="label">Dirección:</span> @entrega.DireccionDestino</p>
                            }

                            <div class="mb-3">
                                <span class="label d-block mb-1">Productos</span>
                                @foreach (var detalle in entrega.Pedido?.Detalles ?? new List<SistemaWeb_Ventas.Models.DetallePedido>())
                                {
                                    <span class="badge border border-secondary text-light me-1 mb-1">
                                        @detalle.Producto?.Nombre x@detalle.Cantidad @(string.IsNullOrEmpty(detalle.TallaSeleccionada) ? "" : "- " + detalle.TallaSeleccionada)
                                    </span>
                                }
                            </div>

                            <div class="d-flex gap-2">
                                @if (entrega.Pedido?.EstadoPedido == "Aprobado" || entrega.Pedido?.EstadoPedido == "Pendiente")
                                {
                                    <form asp-action="MarcarEnCamino" method="post">
                                        <input type="hidden" name="idEntrega" value="@entrega.IdEntrega" />
                                        <button type="submit" class="btn btn-outline-info btn-pill">En camino</button>
                                    </form>
                                }
                                @if (entrega.Pedido?.EstadoPedido == "En despacho")
                                {
                                    <form asp-action="MarcarEntregado" method="post" onsubmit="return confirm('¿Confirmar entrega completada?');">
                                        <input type="hidden" name="idEntrega" value="@entrega.IdEntrega" />
                                        <button type="submit" class="btn btn-red btn-pill">Marcar entregado</button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</body>
</html>
