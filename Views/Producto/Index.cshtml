@model IEnumerable<SistemaWeb_Ventas.Models.Producto>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Productos — Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=Playfair+Display:ital,wght@0,600;1,600&display=swap" rel="stylesheet">

    <style>
            body { background: #0a0a0a; color: #fff; font-family: 'Inter', sans-serif; min-height: 100vh;}

            /* NAVBAR */
            .navbar { background: transparent; padding: 20px 0; border-bottom: 1px solid #1a1a1a; margin-bottom: 30px;}
            .navbar-brand { font-family: 'Playfair Display', serif; font-weight: 600; font-size: 2rem; color: #fff !important; letter-spacing: 1px; text-decoration: none;}
            .navbar-brand span { color: #e63946; }

            /* BOTONES */
            .btn-pill-white { background: #fff; color: #000; border-radius: 50px; padding: 8px 20px; font-weight: 600; font-size: 0.9rem; border: none; transition: all 0.3s; text-decoration: none;}
            .btn-pill-white:hover { background: #e0e0e0; color: #000; }
            .btn-pill-outline { background: transparent; color: #fff; border: 1px solid #444; border-radius: 50px; padding: 8px 20px; font-weight: 600; font-size: 0.9rem; transition: all 0.3s; text-decoration: none;}
            .btn-pill-outline:hover { border-color: #fff; color: #fff; }

            /* TABLA OSCURA */
            .table-dark-custom {
                background: #111;
                color: #fff;
                border-radius: 12px;
                overflow: hidden;
                border: 1px solid #222;
            }
            .table-dark-custom thead {
                background: #1a1a1a;
                color: #aaa;
                font-size: 0.8rem;
                text-transform: uppercase;
                letter-spacing: 1px;
            }
            .table-dark-custom th, .table-dark-custom td {
                border-color: #222;
                vertical-align: middle;
            }
            .table-dark-custom tbody tr:hover {
                background: #151515;
            }
            .img-thumb { width: 50px; height: 50px; object-fit: cover; border-radius: 8px; background: #222; border: 1px solid #333;}
            .desc-cell { max-width: 180px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #888;}

            /* BOTONES DE ACCIÓN */
            .btn-action { width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center; border-radius: 8px; border: 1px solid #333; background: #1a1a1a; color: #aaa; transition: 0.3s;}
            .btn-action:hover { background: #333; color: #fff; }
            .btn-action.edit:hover { border-color: #ffc107; color: #ffc107; }
            .btn-action.delete:hover { border-color: #dc3545; color: #dc3545; }
            .btn-action.toggle:hover { border-color: #0dcaf0; color: #0dcaf0; }
    </style>
</head>
<body>

    <nav class="navbar">
        <div class="container-fluid px-4 d-flex justify-content-between align-items-center">
            <a class="navbar-brand" href="#">QUESITO<span>.</span> <small class="fw-normal text-muted ms-2" style="font-size:0.9rem; font-family:'Inter',sans-serif; letter-spacing:0;">Productos</small></a>
            <div class="d-flex gap-2">
                <a asp-action="Crear" class="btn btn-pill-white"><i class="bi bi-plus-lg me-1"></i> Nuevo Producto</a>
                <a asp-controller="Welcome" asp-action="Administrador" class="btn btn-pill-outline">Panel</a>
            </div>
        </div>
    </nav>

    <div class="container-fluid px-4">
        <div class="table-responsive">
            <table class="table table-dark-custom align-middle">
                <thead>
                    <tr>
                        <th class="ps-3">Img</th>
                        <th>Nombre</th>
                        <th>Categoría</th>
                        <th>Tallas</th>
                        <th>Descripción</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th>Estado</th>
                        <th class="text-center pe-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr class="@(p.Activo ? "" : "opacity-50")">
                            <td class="ps-3">
                                @if (!string.IsNullOrEmpty(p.ImagenUrl))
                                {
                                    <img src="@p.ImagenUrl" class="img-thumb" />
                                }
                                else
                                {
                                    <div class="img-thumb d-flex align-items-center justify-content-center text-muted"><i class="bi bi-image"></i></div>
                                }
                            </td>
                            <td class="fw-semibold text-white">@p.Nombre</td>
                            <td><span class="badge bg-dark border border-secondary text-light">@p.Categoria?.NombreCategoria</span></td>
                            <td class="text-muted small">@p.Talla</td>
                            <td class="desc-cell small" title="@p.Descripcion">@p.Descripcion</td>
                            <td class="fw-bold" style="color:#e63946;">S/ @p.Precio.ToString("0.00")</td>
                            <td class="text-dark">@p.Stock</td>
                            <td>
                                @if (p.Activo)
                                {
                                    <span class="badge" style="background:rgba(25,135,84,.2); color:#198754; border:1px solid rgba(25,135,84,.3);">Activo</span>
                                }
                                else
                                {
                                    <span class="badge" style="background:rgba(108,117,125,.2); color:#aaa; border:1px solid rgba(108,117,125,.3);">Inactivo</span>
                                }
                            </td>
                            <td class="text-center pe-3">
                                <div class="d-flex gap-2 justify-content-center">
                                    <a asp-action="Editar" asp-route-id="@p.IdProducto" class="btn-action edit" title="Editar"><i class="bi bi-pencil"></i></a>

                                    <form asp-action="Desactivar" asp-route-id="@p.IdProducto" method="post" class="m-0">
                                        <button class="btn-action toggle" title="@(p.Activo ? "Desactivar" : "Activar")">
                                            <i class="bi @(p.Activo ? "bi-eye-slash" : "bi-eye")"></i>
                                        </button>
                                    </form>

                                    <form asp-action="Eliminar" asp-route-id="@p.IdProducto" method="post" class="m-0" onsubmit="return confirm('¿Eliminar este producto? Esta acción no se puede deshacer.')">
                                        <button class="btn-action delete" title="Eliminar"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>