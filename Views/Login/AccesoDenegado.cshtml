@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Acceso denegado — Quesito Store</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            min-height: 100vh;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #0a0a0a;
            color: #fff;
            font-family: "Segoe UI", sans-serif;
        }
        .access-card {
            width: min(520px, calc(100% - 32px));
            padding: 40px;
            text-align: center;
            background: #111;
            border: 1px solid #222;
            border-radius: 16px;
        }
        .access-icon {
            width: 72px;
            height: 72px;
            margin: 0 auto 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: rgba(230, 57, 70, 0.12);
            color: #e63946;
            font-size: 2rem;
        }
        .btn-red {
            background: #e63946;
            color: #fff;
            border: none;
            border-radius: 50px;
            padding: 10px 22px;
        }
        .btn-red:hover { background: #c1121f; color: #fff; }
    </style>
</head>
<body>
    <div class="access-card">
        <div class="access-icon"><i class="bi bi-shield-lock"></i></div>
        <h2 class="fw-bold">Acceso denegado</h2>
        <p class="text-secondary mt-3 mb-4">Tu cuenta no tiene permiso para abrir esta sección.</p>
        <a href="/" class="btn btn-red"><i class="bi bi-arrow-left me-2"></i>Volver a mi panel</a>
    </div>
</body>
</html>
