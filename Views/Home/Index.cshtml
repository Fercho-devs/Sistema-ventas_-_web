@{
    ViewData["Title"] = "Inicio";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Quesito Store</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body { background: #0a0a0a; color: #fff; font-family: "Segoe UI", sans-serif; min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
        .brand { font-size: 3rem; font-weight: 900; letter-spacing: 3px; margin-bottom: 1rem; }
        .brand span { color: #e63946; }
        .btn-quesito { background: #e63946; color: #fff; border: none; padding: 12px 32px; font-size: 1.1rem; font-weight: 700; border-radius: 6px; text-decoration: none; transition: background 0.2s; }
        .btn-quesito:hover { background: #c1121f; color: #fff; }
    </style>
</head>
<body>
    <div class="brand">QUESITO<span>STORE</span></div>
    <p class="text-muted mb-4">Ropa urbana en Cajamarca</p>
    <a asp-controller="Login" asp-action="Index" class="btn-quesito">
        <i class="bi bi-box-arrow-in-right"></i> Iniciar Sesión
    </a>
</body>
</html>