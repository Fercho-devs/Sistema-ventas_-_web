@{
    ViewData["Title"] = "Inicio";
    Layout = null;
    var isAuthenticated = User.Identity.IsAuthenticated;
    var nombreUsuario = ViewBag.Nombre as string ?? User.Identity.Name;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Quesito Store — Ropa Urbana en Cajamarca</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=Playfair+Display:ital,wght@0,600;1,600&display=swap" rel="stylesheet">

    <style>
            body {
                font-family: 'Inter', sans-serif;
                background: #0a0a0a;
                color: #fff;
                overflow-x: hidden;
            }

            /* NAVBAR */
            .navbar {
                background: transparent;
                padding: 20px 0;
            }

            .navbar-brand {
                font-family: 'Playfair Display', serif;
                font-weight: 600;
                font-size: 2rem;
                color: #fff !important;
                letter-spacing: 1px;
            }

                .navbar-brand span {
                    color: #e63946;
                }

            .nav-pill-container {
                background: #1a1a1a;
                border-radius: 50px;
                padding: 5px 10px;
                display: inline-flex;
                align-items: center;
                gap: 5px;
            }

            .nav-pill-link {
                color: #aaa;
                text-decoration: none;
                padding: 8px 20px;
                border-radius: 50px;
                font-size: 0.9rem;
                transition: all 0.3s;
            }

                .nav-pill-link:hover, .nav-pill-link.active {
                    background: #fff;
                    color: #000;
                }

            /* BOTONES */
            .btn-pill-white {
                background: #fff;
                color: #000;
                border-radius: 50px;
                padding: 10px 24px;
                font-weight: 600;
                font-size: 0.9rem;
                border: none;
                transition: all 0.3s;
                display: inline-flex;
                align-items: center;
                gap: 10px;
                text-decoration: none;
            }

                .btn-pill-white:hover {
                    background: #e0e0e0;
                    color: #000;
                }

            .btn-pill-outline {
                background: transparent;
                color: #fff;
                border: 1px solid #444;
                border-radius: 50px;
                padding: 10px 24px;
                font-weight: 600;
                font-size: 0.9rem;
                transition: all 0.3s;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
            }

                .btn-pill-outline:hover {
                    border-color: #fff;
                    color: #fff;
                }

            /* HERO */
            .hero {
                min-height: 85vh;
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
                text-align: center;
                padding-top: 5vh;
                background: #0a0a0a;
            }

            .hero-title {
                font-size: 4rem;
                font-weight: 300;
                letter-spacing: 2px;
                line-height: 1.1;
                text-transform: uppercase;
                margin-bottom: 20px;
            }

                .hero-title span {
                    color: #e63946;
                    font-weight: 600;
                }

            .hero-sub {
                font-size: 1rem;
                color: #888;
                max-width: 600px;
                margin: 0 auto 40px auto;
                line-height: 1.6;
            }

            .btn-hero-collection {
                background: #fff;
                color: #000;
                border-radius: 50px;
                padding: 8px 8px 8px 24px;
                font-weight: 500;
                display: inline-flex;
                align-items: center;
                gap: 15px;
                border: none;
                transition: all 0.3s;
                text-decoration: none;
            }

                .btn-hero-collection:hover {
                    background: #eee;
                    color: #000;
                }

                .btn-hero-collection .icon-circle {
                    background: #000;
                    color: #fff;
                    width: 35px;
                    height: 35px;
                    border-radius: 50%;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                }

            /* GALERÍA DE ARCOS */
            .arch-gallery {
                display: flex;
                justify-content: center;
                align-items: flex-end;
                gap: 20px;
                margin-top: 60px;
                height: 350px;
                overflow: hidden;
            }

            .arch {
                width: 200px;
                height: 300px;
                border-radius: 100px 100px 0 0;
                overflow: hidden;
                background: #1a1a1a;
                position: relative;
                transition: transform 0.3s;
            }

                .arch img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    filter: brightness(0.8);
                    transition: filter 0.3s;
                }

                .arch:hover img {
                    filter: brightness(1);
                }

                .arch.center {
                    height: 350px;
                    width: 240px;
                    border: 2px solid #222;
                }

                    .arch.center img {
                        object-fit: contain;
                        background: #fff;
                        padding: 20px;
                    }

                .arch.side-1 {
                    height: 220px;
                }

                .arch.side-2 {
                    height: 260px;
                }

            /* SOBRE NOSOTROS */
            .about-us {
                background: #0d0d0d;
                border-top: 1px solid #1a1a1a;
            }

            /* CATEGORÍAS */
            .categories {
                background: #0a0a0a;
                padding: 60px 0;
            }

            .cat-badge-img {
                position: relative;
                padding: 1.2rem 2rem;
                border-radius: 50px;
                font-size: 1rem;
                color: #fff;
                font-weight: 600;
                text-decoration: none;
                background-size: cover;
                background-position: center;
                overflow: hidden;
                transition: transform 0.3s, box-shadow 0.3s, border-color 0.3s;
                border: 1px solid #333;
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

                .cat-badge-img::before {
                    content: '';
                    position: absolute;
                    inset: 0;
                    background: rgba(0, 0, 0, 0.65);
                    transition: background 0.3s;
                    z-index: 1;
                }

                .cat-badge-img:hover {
                    transform: translateY(-5px);
                    box-shadow: 0 6px 20px rgba(230, 57, 70, 0.3);
                    border-color: #e63946;
                }

                    .cat-badge-img:hover::before {
                        background: rgba(230, 57, 70, 0.5);
                    }

                .cat-badge-img span {
                    position: relative;
                    z-index: 2;
                }

            /* FEATURES */
            .features {
                background: #111;
                border-top: 1px solid #222;
                padding: 60px 0;
            }

            .feature-card {
                background: #1a1a1a;
                border: 1px solid #2a2a2a;
                border-radius: 20px;
                padding: 2rem;
                text-align: center;
                transition: border-color .2s;
                height: 100%;
            }

                .feature-card:hover {
                    border-color: #e63946;
                }

            .feature-icon {
                font-size: 2rem;
                color: #e63946;
                margin-bottom: 1rem;
            }

            footer {
                background: #050505;
                border-top: 1px solid #1a1a1a;
                color: #555;
                padding: 30px 0;
            }

            /* OFFCANVAS */
            .offcanvas {
                background: #111;
                border-left: 1px solid #222;
                color: #fff;
            }

            .offcanvas-header {
                border-bottom: 1px solid #222;
            }

            @@media (max-width: 768px) {
                .hero-title {
                    font-size: 2.5rem;
                }

                .nav-pill-container {
                    display: none;
                }

                .arch-gallery {
                    height: 250px;
                    gap: 10px;
                }

                .arch {
                    width: 120px;
                    height: 200px;
                }

                    .arch.center {
                        width: 150px;
                        height: 250px;
                    }

                    .arch.side-1, .arch.side-2 {
                        display: none;
                    }

                .cat-badge-img {
                    padding: 1rem 1.5rem;
                    font-size: 0.9rem;
                }
            }
    </style>
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar">
        <div class="container d-flex justify-content-between align-items-center">
            <a class="navbar-brand" href="#">QUESITO<span>.</span></a>

            <div class="nav-pill-container d-none d-lg-flex">
                <a href="#" class="nav-pill-link active">Inicio</a>
                @if (isAuthenticated)
                {
                    <a asp-controller="Pedido" asp-action="Catalogo" class="nav-pill-link">Catálogo</a>
                }
                <a href="#" class="nav-pill-link">Ofertas</a>
            </div>

            <div class="d-flex gap-3 align-items-center">
                @if (isAuthenticated)
                {
                    <span class="text-white small d-none d-md-block me-2">
                        <i class="bi bi-person-circle me-1" style="color:#e63946"></i> @nombreUsuario
                    </span>

                    <button class="btn btn-pill-outline" data-bs-toggle="offcanvas" data-bs-target="#offcanvasPedidos">
                        <i class="bi bi-receipt me-1"></i> Mis Pedidos
                    </button>

                    <form asp-controller="Login" asp-action="Salir" method="post" class="d-inline m-0 p-0">
                        <button type="submit" class="btn btn-pill-white">
                            Salir <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Login" asp-action="LogIn" class="btn btn-pill-outline">
                        Iniciar Sesión
                    </a>
                    <a asp-controller="Login" asp-action="Registro" class="btn btn-pill-white">
                        Crear Cuenta <i class="bi bi-arrow-right"></i>
                    </a>
                }
            </div>
        </div>
    </nav>

    <!-- HERO -->
    <section class="hero container">
        <p class="text-uppercase mb-3" style="color:#e63946; font-size:.85rem; font-weight:600; letter-spacing:4px;">Ropa Urbana — Cajamarca</p>

        <h1 class="hero-title">TU ESTILO,<br /><span>TU IDENTIDAD.</span></h1>

        <p class="hero-sub">
            Prendas y accesorios de moda urbana (streetwear) para hombres y mujeres.
            Encuentra polos, buzos, pantalones baggy, zapatillas y gorras de calidad.
        </p>

        @if (isAuthenticated)
        {
            <a asp-controller="Pedido" asp-action="Catalogo" class="btn-hero-collection">
                Comprar Ahora
                <span class="icon-circle"><i class="bi bi-arrow-right"></i></span>
            </a>
        }
        else
        {
            <a asp-controller="Login" asp-action="LogIn" class="btn-hero-collection">
                Comprar Ahora
                <span class="icon-circle"><i class="bi bi-arrow-right"></i></span>
            </a>
        }

        <!-- GALERÍA DE ARCOS -->
        <div class="arch-gallery">
            <div class="arch side-1 d-none d-md-block"><img src="https://images.unsplash.com/photo-1509942774463-acf339cf87d5?q=80&w=600&auto=format&fit=crop" alt="Moda Urbana Hombre"></div>
            <div class="arch side-2"><img src="https://images.unsplash.com/photo-1552346154-21d32810aba3?q=80&w=600&auto=format&fit=crop" alt="Zapatillas Urbanas"></div>
            <div class="arch center"><img src="~/images/Logo.png" alt="Logo Quesito Store"></div>
            <div class="arch side-2"><img src="https://images.unsplash.com/photo-1556821840-3a63f95609a7?q=80&w=600&auto=format&fit=crop" alt="Poleras y Buzos"></div>
            <div class="arch side-1 d-none d-md-block"><img src="https://images.unsplash.com/photo-1517423568366-8b83523034fd?q=80&w=600&auto=format&fit=crop" alt="Estilo Streetwear"></div>
        </div>
    </section>

    <!-- SOBRE NOSOTROS -->
    <section class="about-us py-5 text-center">
        <div class="container">
            <h3 class="fw-bold mb-3" style="font-family: 'Playfair Display', serif; color: #fff;">Nuestra Esencia</h3>
            <p class="text-muted mx-auto mb-0" style="max-width: 800px; line-height: 1.8;">
                En <strong>Quesito Store</strong> nos dedicamos a la comercialización de prendas de vestir, calzado y accesorios de moda urbana.
                Nacimos en Cajamarca con la visión de consolidarnos como una marca reconocida, destacando por nuestra identidad propia,
                innovación y compromiso con brindarte una experiencia de compra satisfactoria.
            </p>
        </div>
    </section>

    <!-- CATEGORIAS -->
    <section class="categories">
        <div class="container text-center">
            <p class="text-uppercase mb-4" style="color:#888; font-size:.8rem; font-weight:600; letter-spacing:3px;">Explora nuestras categorías</p>
            <div class="d-flex flex-wrap gap-3 justify-content-center">
                <a href="#" class="cat-badge-img" style="background-image: url('https://images.unsplash.com/photo-1588850561407-ed78c282e89b?q=80&w=400&auto=format&fit=crop');">
                    <span><i class="bi bi-star me-2" style="color:#e63946"></i>Gorras</span>
                </a>
                <a href="#" class="cat-badge-img" style="background-image: url('https://images.unsplash.com/photo-1552346154-21d32810aba3?q=80&w=400&auto=format&fit=crop');">
                    <span><i class="bi bi-star me-2" style="color:#e63946"></i>Zapatillas</span>
                </a>
                <a href="#" class="cat-badge-img" style="background-image: url('https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?q=80&w=400&auto=format&fit=crop');">
                    <span><i class="bi bi-star me-2" style="color:#e63946"></i>Polos</span>
                </a>
                <a href="#" class="cat-badge-img" style="background-image: url('https://images.unsplash.com/photo-1556821840-3a63f95609a7?q=80&w=400&auto=format&fit=crop');">
                    <span><i class="bi bi-star me-2" style="color:#e63946"></i>Poleras / Buzos</span>
                </a>
                <a href="#" class="cat-badge-img" style="background-image: url('https://images.unsplash.com/photo-1517423568366-8b83523034fd?q=80&w=400&auto=format&fit=crop');">
                    <span><i class="bi bi-star me-2" style="color:#e63946"></i>Pantalones</span>
                </a>
            </div>
        </div>
    </section>

    <!-- FEATURES -->
    @if (!isAuthenticated)
    {
        <section class="features">
            <div class="container">
                <div class="row g-4">
                    <div class="col-md-4">
                        <div class="feature-card">
                            <div class="feature-icon"><i class="bi bi-scooter"></i></div>
                            <h6 class="fw-bold mb-2">Delivery Gratuito en Cajamarca</h6>
                            <p class="text-muted small mb-0">Llevamos tu pedido directo a tu puerta sin costo adicional dentro de la ciudad.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="feature-card">
                            <div class="feature-icon"><i class="bi bi-truck"></i></div>
                            <h6 class="fw-bold mb-2">Envíos a Todo el Perú</h6>
                            <p class="text-muted small mb-0">Ampliamos nuestro alcance para que recibas tus prendas en cualquier ciudad del país.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="feature-card">
                            <div class="feature-icon"><i class="bi bi-shield-check"></i></div>
                            <h6 class="fw-bold mb-2">Atención Personalizada</h6>
                            <p class="text-muted small mb-0">Nos caracterizamos por brindarte una atención cercana y un compromiso total con tu compra.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }

    <!-- FOOTER -->
    <footer class="text-center">
        <div class="container">
            <p class="mb-0">© 2026 <strong style="color:#fff">Quesito Store</strong> — Cajamarca, Perú. Todos los derechos reservados.</p>
            <p class="small mt-2 mb-0" style="color: #444;">Av. Miguel Cardozo N.° 385 | WhatsApp: 931 718 114 | IG: @@quesito_store02</p>
        </div>
    </footer>

    <!-- OFFCANVAS -->
    @if (isAuthenticated)
    {
        <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasPedidos" aria-labelledby="offcanvasPedidosLabel">
            <div class="offcanvas-header">
                <h5 class="offcanvas-title fw-bold" id="offcanvasPedidosLabel"><i class="bi bi-receipt me-2" style="color:#e63946"></i>Mis Pedidos</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body">
                
                @if (ViewBag.PedidosRecientes != null && ViewBag.PedidosRecientes.Count > 0)
                {
                    <p class="text-muted small">Tus compras más recientes:</p>
                    
                    <!-- Bucle para mostrar los 2 pedidos reales -->
                    @foreach (var pedido in ViewBag.PedidosRecientes)
                    {
                        <div class="p-3 mb-3" style="background:#1a1a1a; border-radius:10px; border: 1px solid #333;">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="fw-bold text-white">Pedido #@pedido.IdPedido</span>
                                @{
                                    var statusBadge = pedido.EstadoPedido switch {
                                        "Pendiente" => "bg-warning text-dark",
                                        "Aprobado" => "bg-info text-dark",
                                        "Cancelado" => "bg-danger",
                                        "Finalizado" => "bg-success",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @statusBadge">@pedido.EstadoPedido</span>
                            </div>
                            <span class="text-muted small">@pedido.FechaPedido.ToString("dd/MM/yyyy") — Total: S/ @pedido.Total.ToString("0.00")</span>
                        </div>
                    }
                    
                    <a asp-controller="Pedido" asp-action="MisPedidos" class="btn btn-pill-white w-100 mt-4 justify-content-center">
                        Ver historial completo <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                }
                else
                {
                    <!-- Mensaje si no hay pedidos -->
                    <div class="text-center mt-5">
                        <i class="bi bi-box-seam mb-3" style="font-size: 3rem; color: #333;"></i>
                        <h6 class="text-white">Aún no tienes pedidos</h6>
                        <p class="text-muted small">Cuando realices una compra, aparecerá aquí.</p>
                        <a asp-controller="Pedido" asp-action="Catalogo" class="btn btn-pill-outline mt-2">
                            Ir al Catálogo
                        </a>
                    </div>
                }
            </div>
        </div>
    }

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>